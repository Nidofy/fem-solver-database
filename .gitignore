# Parent-solver integration notes stay local; do not publish with this module.
/docs/MIGRATION.md
/docs/MODERNIZATION_ROADMAP.md

# Historical host logs/manifests contain parent repository paths and references.
# Publish only portable reproduction tools and the standalone verification summary.
/verification/*
!/verification/README.md
!/verification/reproduce.ps1
!/verification/reproduce_lifecycle.ps1
!/verification/summarize_benchmarks.py
# Curated batch-review packets are authored for publication (no host-local paths).
!/verification/reviews/
/verification/reviews/DBF3/independent-astra/scratch/
/verification/reviews/DBF4/independent-astra/scratch/
/verification/reviews/DBF5/independent-astra/scratch/
/verification/reviews/DBF5/*-scratch/
/verification/reviews/DBF5/compression-benchmark/
/verification/reviews/DBF6/independent-current/runtime/
/verification/reviews/DBF6/independent-current/probe-runtime/
# Batch identity validator is a portable tool, same as the reproduce scripts.
!/verification/validate_batch_identity.py
