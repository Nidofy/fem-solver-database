if(NOT BUILD_TESTING)
  return()
endif()
foreach(contract IN ITEMS dbf10_thermal dbf10_history dbf10_legacy_wire dbf11_partitions)
  add_executable(sdb_${contract} tests/${contract}.cpp)
  target_link_libraries(sdb_${contract} PRIVATE solver_database_v2)
  if(MSVC)
    target_compile_options(sdb_${contract} PRIVATE /bigobj)
  elseif(MINGW)
    target_compile_options(sdb_${contract} PRIVATE -Wa,-mbig-obj)
  endif()
endforeach()
add_test(NAME dbf10_legacy_wire COMMAND sdb_dbf10_legacy_wire read
  ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/dbf10/model-v1-v10-index${SDB_INDEX_BITS}.bin)
foreach(op IN ITEMS write read)
  add_test(NAME dbf10_thermal_${op} COMMAND sdb_dbf10_thermal ${op}
    ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/abaqus/forced_tet.inp ${CMAKE_CURRENT_BINARY_DIR}/dbf10-thermal.sdbm)
  add_test(NAME dbf10_history_${op} COMMAND sdb_dbf10_history ${op} ${CMAKE_CURRENT_BINARY_DIR}/dbf10-history.sdb)
endforeach()
foreach(area IN ITEMS thermal history)
  set_tests_properties(dbf10_${area}_write PROPERTIES FIXTURES_SETUP dbf10_${area}_files)
  set_tests_properties(dbf10_${area}_read PROPERTIES FIXTURES_REQUIRED dbf10_${area}_files)
endforeach()
find_package(Python3 QUIET COMPONENTS Interpreter)
if(NOT Python3_Interpreter_FOUND)
  message(STATUS "DBF11 independent-process tests require a Python interpreter")
  return()
endif()
foreach(op IN ITEMS create query restore faults)
  add_test(NAME dbf11_${op} COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/dbf11_processes.py
           $<TARGET_FILE:sdb_dbf11_partitions> ${op} ${CMAKE_CURRENT_BINARY_DIR}/dbf11-parts)
endforeach()
set_tests_properties(dbf11_create PROPERTIES FIXTURES_SETUP dbf11_files)
set_tests_properties(dbf11_query dbf11_restore dbf11_faults PROPERTIES FIXTURES_REQUIRED dbf11_files)
