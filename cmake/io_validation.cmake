option(SDB_FUZZING "Build Clang libFuzzer INP/native/checkpoint targets" OFF)
if(SDB_FUZZING)
  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR WIN32)
    message(FATAL_ERROR "SDB_FUZZING requires Linux Clang with compiler-rt")
  endif()
  foreach(target RANGE 1 3)
    add_executable(sdb_fuzz_io${target} tests/fuzz/io_fuzzer.cpp)
    target_link_libraries(sdb_fuzz_io${target} PRIVATE sdb_lifecycle)
    target_compile_definitions(sdb_fuzz_io${target} PRIVATE SDB_FUZZ_TARGET=${target})
    target_compile_options(sdb_fuzz_io${target} PRIVATE -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=all)
    target_link_options(sdb_fuzz_io${target} PRIVATE -fsanitize=fuzzer,address,undefined)
  endforeach()
endif()

option(SDB_IO_FAULT_TESTS "Test Linux publication failures on private scratch files" OFF)
if(SDB_IO_FAULT_TESTS)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "SDB_IO_FAULT_TESTS requires Linux")
  endif()
  enable_language(C)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  add_library(sdb_fault_syscalls SHARED tests/io_fault/interpose.c)
  target_link_libraries(sdb_fault_syscalls PRIVATE ${CMAKE_DL_LIBS})
  add_executable(sdb_fault_atomic tests/io_fault/atomic_worker.cpp)
  target_link_libraries(sdb_fault_atomic PRIVATE sdb_lifecycle)
  add_test(NAME publication_io_failures COMMAND ${Python3_EXECUTABLE}
    ${CMAKE_CURRENT_SOURCE_DIR}/tests/io_fault/campaign.py
    $<TARGET_FILE:sdb_fault_atomic> $<TARGET_FILE:sdb_fault_syscalls>)
endif()
