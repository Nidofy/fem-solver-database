option(SDB_FUZZING "Build Clang libFuzzer INP/native/checkpoint targets" OFF)
if(SDB_FUZZING)
  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR WIN32)
    message(FATAL_ERROR "SDB_FUZZING requires Linux Clang with compiler-rt")
  endif()
  foreach(target RANGE 1 3)
    add_executable(sdb_fuzz_io${target} tests/fuzz/io_fuzzer.cpp)
    target_link_libraries(sdb_fuzz_io${target} PRIVATE sdb_lifecycle)
    target_compile_definitions(sdb_fuzz_io${target} PRIVATE SDB_FUZZ_TARGET=${target})
    target_compile_options(sdb_fuzz_io${target} PRIVATE -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=all)
    target_link_options(sdb_fuzz_io${target} PRIVATE -fsanitize=fuzzer,address,undefined)
  endforeach()
endif()
