if(BUILD_TESTING)
  foreach(contract IN ITEMS slots spectral)
    add_executable(sdb_dbf12_${contract} tests/dbf12_${contract}.cpp)
    target_link_libraries(sdb_dbf12_${contract} PRIVATE solver_database_v2)
    if(MINGW)
      target_compile_options(sdb_dbf12_${contract} PRIVATE -Wa,-mbig-obj)
    endif()
  endforeach()
  target_link_libraries(sdb_dbf12_spectral PRIVATE process_memory)
  if(MINGW)
    # The test intercepts global new/delete. Filesystem paths must use the
    # same allocator inside libstdc++ as the code measuring their lifetime.
    target_link_options(sdb_dbf12_spectral PRIVATE -static-libstdc++)
  endif()
  set(dbf12_parents dbf9_multi_file)
  set(dbf12_partition bundle)
  if(TEST dbf11_create)
    list(APPEND dbf12_parents dbf11_files)
    set(dbf12_partition partition)
  endif()
  add_test(NAME dbf12_slots COMMAND sdb_dbf12_slots ${CMAKE_CURRENT_BINARY_DIR}/dbf12-slots ${dbf12_partition})
  set_tests_properties(dbf12_slots PROPERTIES FIXTURES_REQUIRED "${dbf12_parents}")
  foreach(op IN ITEMS write read faults)
    add_test(NAME dbf12_spectral_${op} COMMAND sdb_dbf12_spectral ${op} ${CMAKE_CURRENT_BINARY_DIR}/dbf12-spectral)
  endforeach()
  if(Python3_Interpreter_FOUND)
    add_test(NAME dbf12_spectral_wire COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/dbf12_wire.py
             ${CMAKE_CURRENT_BINARY_DIR}/dbf12-spectral $<BOOL:${SDB_ZSTD}>)
    set_tests_properties(dbf12_spectral_wire PROPERTIES FIXTURES_REQUIRED dbf12_spectral_files)
  endif()
  set_tests_properties(dbf12_spectral_write PROPERTIES FIXTURES_SETUP dbf12_spectral_files)
  set_tests_properties(dbf12_spectral_read dbf12_spectral_faults PROPERTIES FIXTURES_REQUIRED dbf12_spectral_files)
endif()
